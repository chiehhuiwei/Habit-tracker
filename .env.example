BQ_PROJECT_ID=xxxx
BQ_DATASET_ID=xxxx
GOOGLE_APPLICATION_CREDENTIALS=xxx/xxx/xxx

GARMIN_EMAIL=xxxx
GARMIN_PASSWORD=xxxx
GARMIN_TOKEN_STORE=~/.garminconnect

# LINE OA（留空則不啟用，網頁版行為不變）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 選填：留空則第一個傳訊息的人自動綁定為擁有者
LINE_OWNER_USER_ID=
# 選填：預設為專案下的 line_data/
LINE_DATA_DIR=
# 使用 docker compose --profile https 時 Caddy 申請憑證的網域
LINE_DOMAIN=